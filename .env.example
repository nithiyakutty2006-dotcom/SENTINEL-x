# Bootstrap credentials are read only when the users table is empty.
SENTINEL_ADMIN_USERNAME=admin
SENTINEL_ADMIN_PASSWORD=replace-with-a-unique-long-password

# Optional additional RBAC accounts (set both values for each account).
SENTINEL_ANALYST_USERNAME=analyst
SENTINEL_ANALYST_PASSWORD=replace-with-a-unique-long-password
SENTINEL_VIEWER_USERNAME=viewer
SENTINEL_VIEWER_PASSWORD=replace-with-a-unique-long-password

# For a Render service with an attached persistent disk, set this to /var/data.
# SENTINEL_DATA_DIR=/var/data

# Monitoring mode: auto uses demo on Render and real Scapy capture elsewhere.
# Set to "demo" for simulated hosted events, or "real" on a supported capture host.
# SENTINEL_MONITORING_MODE=auto

# Optional authenticated Windows sensor identity. Configure both values privately
# in the backend environment and the local PowerShell process; never commit a secret.
# SENTINEL_SENSOR_ID=
# SENTINEL_SENSOR_SECRET=
